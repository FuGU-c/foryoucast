# Future server-side integration only. The local demo works without these.
# start-demo.ps1 loads .env into its process; never commit a real .env.

WORKFLOW_SECRET=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Store ELEVENLABS_API_KEY as an n8n Header Auth credential (xi-api-key),
# not in the frontend or workflow JSON. Do not put that secret here.
# The live integration also needs a reachable authenticated HTTPS backend.
